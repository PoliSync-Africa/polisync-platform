PORT=5000

MONGODB_URI=YOUR_MONGODB_ATLAS_CONNECTION_STRING

# Generate a unique random secret of at least 32 characters for production.
JWT_SECRET=REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_SECRET

NODE_ENV=development

FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Required for protected setup/bootstrap operations.
SETUP_SECRET=REPLACE_WITH_A_LONG_RANDOM_SETUP_SECRET
POLISYNC_API_TOKEN=REPLACE_WITH_A_LONG_RANDOM_API_TOKEN
